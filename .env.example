# Copiar a .env solo en desarrollo local. Nunca guardar secretos aquí.
HOST=0.0.0.0
PORT=8443

# Transporte TLS. Los ficheros se generan con scripts/generate_certs.sh.
TLS_CERT_FILE=certs/server-chain.pem
TLS_KEY_FILE=certs/server.key.pem

# Persistencia y auditoría. El servidor no debe escribir plaintext de mensajes.
DATA_DIR=data
MESSAGING_DATABASE=data/messaging.sqlite3

# Secretos de sesión: reemplazar por un valor aleatorio de alta entropía fuera
# de Git (por ejemplo, un gestor de secretos). El valor de ejemplo no es válido
# para producción.
SESSION_SECRET=replace-with-a-random-32-byte-secret
ENABLE_API_DOCS=0
ADMIN_USERNAME=

# Parámetros de sesiones y mensajes.
SESSION_TTL_SECONDS=3600
# Rate limit actualmente aplicado al login dentro de un solo proceso.
LOGIN_RATE_WINDOW_SECONDS=300
LOGIN_RATE_MAX_ATTEMPTS=8
CORS_ORIGINS=https://localhost:8443

# Parámetros Argon2id acotados y leídos por el backend.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=2

# Backups operativos.
BACKUP_DIR=backups
